<aside class="analytics-consent" id="analytics-consent" aria-labelledby="analytics-consent-title" hidden>
  <div>
    <strong id="analytics-consent-title">Mesure d’audience</strong>
    <p>Avec votre accord, nous utilisons Google Analytics pour comprendre l’utilisation du site et l’améliorer.</p>
    <a href="/politique-de-confidentialite/">En savoir plus</a>
  </div>
  <div class="analytics-consent__actions">
    <button class="button button--quiet" type="button" data-analytics-choice="denied">Refuser</button>
    <button class="button" type="button" data-analytics-choice="granted">Accepter</button>
  </div>
</aside>

<script is:inline>
  const consentKey = "calculette-mauricette-analytics-consent";
  const measurementId = "G-7JLTGG26MX";
  const banner = document.querySelector("#analytics-consent");

  function loadAnalytics() {
    if (document.querySelector(`script[data-ga-measurement="${measurementId}"]`)) return;
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", measurementId);
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    script.dataset.gaMeasurement = measurementId;
    document.head.append(script);
  }

  function applyChoice(choice) {
    localStorage.setItem(consentKey, choice);
    if (choice === "granted") loadAnalytics();
    if (choice === "denied" && window.gtag) {
      window.gtag("consent", "update", { analytics_storage: "denied" });
    }
    if (banner) banner.hidden = true;
  }

  const savedChoice = localStorage.getItem(consentKey);
  if (savedChoice === "granted") loadAnalytics();
  else if (!savedChoice && banner) banner.hidden = false;

  banner?.querySelectorAll("[data-analytics-choice]").forEach((button) => {
    button.addEventListener("click", () => applyChoice(button.dataset.analyticsChoice));
  });

  document.querySelectorAll("[data-analytics-settings]").forEach((button) => {
    button.addEventListener("click", () => {
      if (banner) banner.hidden = false;
      banner?.querySelector<HTMLButtonElement>("[data-analytics-choice='granted']")?.focus();
    });
  });
</script>
