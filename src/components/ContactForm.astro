---
import { siteConfig } from "../config/site";

const isConfigured = Boolean(
  siteConfig.contact.formEndpoint && siteConfig.contact.formProvider,
);
---

<div class="contact-form-shell">
  {!isConfigured && (
    <div class="configuration-notice" role="note">
      <strong>L'envoi en ligne n'est pas encore activé.</strong>
      <p>Le formulaire est prêt, mais aucun destinataire n'est configuré. Aucun message ne sera envoyé tant que cette configuration manque.</p>
    </div>
  )}

  <form
    class="contact-form"
    id="contact-form"
    action={isConfigured ? siteConfig.contact.formEndpoint : undefined}
    method="POST"
    novalidate
    data-configured={String(isConfigured)}
  >
    <div class="form-summary" id="contact-form-summary" role="alert" tabindex="-1" hidden></div>

    <div class="form-field">
      <label for="contact-name">Nom</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isConfigured} aria-describedby="contact-name-error" />
      <span class="field-error" id="contact-name-error"></span>
    </div>

    <div class="form-field">
      <label for="contact-email">Adresse e-mail</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isConfigured} aria-describedby="contact-email-error" />
      <span class="field-error" id="contact-email-error"></span>
    </div>

    <div class="form-field">
      <label for="contact-subject">Sujet</label>
      <select id="contact-subject" name="subject" required disabled={!isConfigured} aria-describedby="contact-subject-error">
        <option value="">Choisissez un sujet</option>
        <option value="question">Question</option>
        <option value="calculator-problem">Problème avec la calculatrice</option>
        <option value="error-report">Signaler une erreur</option>
        <option value="suggestion">Suggestion</option>
        <option value="privacy">Confidentialité</option>
        <option value="other">Autre</option>
      </select>
      <span class="field-error" id="contact-subject-error"></span>
    </div>

    <div class="form-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="7" minlength="20" required disabled={!isConfigured} aria-describedby="contact-message-help contact-message-error"></textarea>
      <span class="field-help" id="contact-message-help">Décrivez le problème ou votre demande en quelques phrases.</span>
      <span class="field-error" id="contact-message-error"></span>
    </div>

    <button class="button" type="submit" disabled={!isConfigured}>Envoyer le message</button>
    <p class="form-privacy-note">Les informations envoyées servent uniquement à répondre à votre message. Consultez notre <a href="/politique-de-confidentialite/">politique de confidentialité</a>.</p>
  </form>

  {siteConfig.contact.email && (
    <p class="contact-email-fallback">Vous pouvez aussi écrire à <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.</p>
  )}
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  form?.addEventListener("submit", (event) => {
    if (form.dataset.configured !== "true") {
      event.preventDefault();
      return;
    }

    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea"));
    const summary = form.querySelector<HTMLElement>("#contact-form-summary");
    let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | undefined;

    fields.forEach((field) => {
      const error = form.querySelector<HTMLElement>(`#${field.id}-error`);
      let message = "";
      if (field.validity.valueMissing) message = "Ce champ est obligatoire.";
      else if (field.validity.typeMismatch) message = "Saisissez une adresse e-mail valide.";
      else if (field.validity.tooShort) message = "Votre message doit contenir au moins 20 caractères.";
      field.setAttribute("aria-invalid", String(Boolean(message)));
      if (error) error.textContent = message;
      if (message && !firstInvalid) firstInvalid = field;
    });

    if (firstInvalid) {
      event.preventDefault();
      if (summary) {
        summary.textContent = "Vérifiez les champs signalés avant d'envoyer votre message.";
        summary.hidden = false;
        summary.focus();
      }
      firstInvalid.focus();
    } else if (summary) {
      summary.hidden = true;
      summary.textContent = "";
    }
  });
</script>
