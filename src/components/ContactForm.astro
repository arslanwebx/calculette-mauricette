---
import { siteConfig } from "../config/site";

---

<div class="contact-form-shell">
  <form
    class="contact-form"
    id="contact-form"
    action={siteConfig.contact.formEndpoint}
    method="POST"
    novalidate
  >
    <input type="hidden" name="access_key" value={siteConfig.contact.formAccessKey} />
    <input type="hidden" name="from_name" value="Calculette Mauricette" />
    <input type="hidden" name="subject" value="Nouveau message depuis Calculette Mauricette" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" aria-hidden="true" />

    <div class="form-summary" id="contact-form-summary" role="alert" tabindex="-1" hidden></div>
    <p class="form-status" id="contact-form-status" aria-live="polite" role="status" hidden></p>

    <div class="form-field">
      <label for="contact-name">Nom</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
      <span class="field-error" id="contact-name-error"></span>
    </div>

    <div class="form-field">
      <label for="contact-email">Adresse e-mail</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="contact-email-error" />
      <span class="field-error" id="contact-email-error"></span>
    </div>

    <div class="form-field">
      <label for="contact-subject">Sujet</label>
      <select id="contact-subject" name="message_subject" required aria-describedby="contact-subject-error">
        <option value="">Choisissez un sujet</option>
        <option value="Question">Question</option>
        <option value="Problème avec la calculatrice">Problème avec la calculatrice</option>
        <option value="Signaler une erreur">Signaler une erreur</option>
        <option value="Suggestion">Suggestion</option>
        <option value="Confidentialité">Confidentialité</option>
        <option value="Autre">Autre</option>
      </select>
      <span class="field-error" id="contact-subject-error"></span>
    </div>

    <div class="form-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="7" minlength="20" required aria-describedby="contact-message-help contact-message-error"></textarea>
      <span class="field-help" id="contact-message-help">Décrivez le problème ou votre demande en quelques phrases.</span>
      <span class="field-error" id="contact-message-error"></span>
    </div>

    <button class="button" type="submit">Envoyer le message</button>
    <p class="form-privacy-note">Les informations envoyées via ce formulaire sont utilisées uniquement pour répondre à votre message. <a href="/politique-de-confidentialite/">Politique de confidentialité</a>.</p>
  </form>

  {siteConfig.contact.email && (
    <p class="contact-email-fallback">Vous pouvez aussi écrire à <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.</p>
  )}
</div>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input:not([type=hidden]):not([type=checkbox]), select, textarea"));
    const summary = form.querySelector<HTMLElement>("#contact-form-summary");
    const status = form.querySelector<HTMLElement>("#contact-form-status");
    const submitButton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | undefined;

    fields.forEach((field) => {
      const error = form.querySelector<HTMLElement>(`#${field.id}-error`);
      let message = "";
      if (field.validity.valueMissing) message = "Ce champ est obligatoire.";
      else if (field.validity.typeMismatch) message = "Saisissez une adresse e-mail valide.";
      else if (field.validity.tooShort) message = "Votre message doit contenir au moins 20 caractères.";
      field.setAttribute("aria-invalid", String(Boolean(message)));
      if (error) error.textContent = message;
      if (message && !firstInvalid) firstInvalid = field;
    });

    if (firstInvalid) {
      if (summary) {
        summary.textContent = "Vérifiez les champs signalés avant d'envoyer votre message.";
        summary.hidden = false;
        summary.focus();
      }
      if (status) {
        status.hidden = true;
        status.textContent = "";
      }
      firstInvalid.focus();
      return;
    }

    if (summary) {
      summary.hidden = true;
      summary.textContent = "";
    }

    if (status) {
      status.textContent = "Envoi en cours…";
      status.hidden = false;
    }
    if (submitButton) submitButton.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = await response.json().catch(() => null) as { success?: boolean } | null;

      if (!response.ok || result?.success !== true) throw new Error("Web3Forms submission failed");

      form.reset();
      if (status) status.textContent = "Merci, votre message a bien été envoyé.";
    } catch {
      if (status) status.textContent = "Une erreur est survenue. Veuillez réessayer dans quelques instants.";
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
