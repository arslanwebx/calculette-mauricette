---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: "home" | "webpage" | "none";
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { title, description, noindex = false, schema = "webpage", breadcrumbs = [] } = Astro.props;
const siteUrl = Astro.site?.origin;
const canonical = !noindex && siteUrl ? new URL(Astro.url.pathname, `${siteUrl}/`).href : undefined;

const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    ...(siteUrl ? { url: siteUrl } : {}),
    name: "Calculette Mauricette",
    inLanguage: "fr-FR",
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    ...(canonical ? { url: canonical } : {}),
    name: "Calculette Mauricette",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Tout système avec un navigateur web",
    browserRequirements: "JavaScript activé",
    inLanguage: "fr-FR",
    isAccessibleForFree: true,
    description,
  },
];

const webpageStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  ...(canonical ? { url: canonical } : {}),
  name: title,
  description,
  inLanguage: "fr-FR",
  ...(siteUrl ? {
    isPartOf: {
      "@type": "WebSite",
      name: "Calculette Mauricette",
      url: siteUrl,
    },
  } : {}),
};

const breadcrumbStructuredData = breadcrumbs.length > 0 && siteUrl
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((breadcrumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: breadcrumb.name,
        item: new URL(breadcrumb.url, `${siteUrl}/`).href,
      })),
    }
  : undefined;

const baseStructuredData = noindex || schema === "none"
  ? []
  : schema === "home"
    ? homeStructuredData
    : [webpageStructuredData];
const structuredData = breadcrumbStructuredData
  ? [...baseStructuredData, breadcrumbStructuredData]
  : baseStructuredData;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#f7f5ef" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Calculette Mauricette" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {structuredData.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7JLTGG26MX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7JLTGG26MX');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
